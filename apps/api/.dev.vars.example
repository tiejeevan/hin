# Local development environment variables for Cloudflare Workers
# Copy this file to .dev.vars (already gitignored) and fill in your values

# Public URLs for SEO / share previews / sitemap (local defaults)
SITE_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8787

# Olabid API Configuration
OLABID_API_KEY=

# Cloudflare Turnstile Configuration (optional for local dev)
TURNSTILE_SECRET_KEY=

# Oracle Cloud Email Delivery (SMTP — hingot.com, us-chicago-1)
OCI_SMTP_HOST=smtp.email.us-chicago-1.oci.oraclecloud.com
OCI_SMTP_PORT=587
OCI_SMTP_USERNAME=
OCI_SMTP_PASSWORD=

# Optional: Oracle HTTPS submit API (future; not used when SMTP is configured)
# OCI_TENANCY_OCID=
# OCI_USER_OCID=
# OCI_FINGERPRINT=
# OCI_PRIVATE_KEY=
# OCI_COMPARTMENT_OCID=
# OCI_EMAIL_SUBMIT_ENDPOINT=

# Optional pepper for OTP hashing (use a long random string in prod)
OTP_PEPPER=

# JWT signing secret (required in production via `wrangler secret put JWT_SECRET`)
JWT_SECRET=

# Web Push VAPID
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@hingot.com
