# Local development environment variables for Cloudflare Workers
# Copy this file to .dev.vars (already gitignored) and fill in your values

# Olabid API Configuration
# Get this key using HTTP Toolkit by intercepting Olabid app requests
OLABID_API_KEY=1BAF2123-00D7-421E-B999-FB0B222D6577

# Cloudflare Turnstile Configuration (optional for local dev)
TURNSTILE_SECRET_KEY=

# Resend email verification
# Create an API key at https://resend.com — never commit the real key
RESEND_API_KEY=
# Must be a verified sender/domain in Resend (e.g. Hin <noreply@yourdomain.com>)
RESEND_FROM_EMAIL=
# Optional pepper for OTP hashing (use a long random string in prod)
OTP_PEPPER=

# JWT signing secret (required in production via `wrangler secret put JWT_SECRET`)
JWT_SECRET=

# Web Push VAPID (generate once; private key is a Worker secret in production)
# Example: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@example.com
