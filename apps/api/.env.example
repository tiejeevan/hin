# Public site URL for SEO / share previews / sitemap (production example)
# SITE_URL=https://hingot.com
# Public API origin (defaults to SITE_URL when media is served on the same host)
# API_PUBLIC_URL=https://hingot.com
# Optional Google Search Console HTML verification token
GOOGLE_SITE_VERIFICATION=

# Olabid API Configuration
# Get this key using HTTP Toolkit by intercepting Olabid app requests
OLABID_API_KEY=your_api_key_here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here

# Cloudflare Turnstile Configuration
TURNSTILE_SECRET_KEY=your_turnstile_secret_here

# Oracle Cloud Email Delivery (HTTPS submit API — hingot.com)
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY=
OCI_COMPARTMENT_OCID=
# OCI_EMAIL_SUBMIT_ENDPOINT=  # optional override
# Optional OTP hash pepper (long random string in production)
OTP_PEPPER=

# JWT signing secret (production Worker secret)
JWT_SECRET=

# Web Push VAPID keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@example.com
