# Local web dev (optional — defaults to http://localhost:5173)
# VITE_SITE_URL=http://localhost:5173

# API Worker origin for Vite proxy + Pages worker build (defaults to http://localhost:8787)
# VITE_API_URL=http://localhost:8787

# Production build example:
# VITE_SITE_URL=https://hingot.com
# VITE_API_URL=https://hingot.com

# VITE_GOOGLE_CLIENT_ID=
# VITE_TURNSTILE_SITE_KEY=
# VITE_GOOGLE_SITE_VERIFICATION=
